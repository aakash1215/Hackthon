# Copy to .env (never commit .env). Paths are relative to the repo root.

# --- LLM: llama-server (open-weight model, OpenAI-compatible API) ---
LLM_BASE_URL=http://127.0.0.1:8080/v1
# CPU/dev: Qwen3-1.7B-Q4_K_M (or Qwen3.5-2B-Q4_K_M) · GPU/demo: Qwen3-4B-Instruct-2507-Q4_K_M
LLM_MODEL=Qwen3-1.7B-Q4_K_M

# --- ASR: faster-whisper ---
# local = run in this process · remote = POST to ASR_URL/internal/asr (cloud GPU box)
ASR_MODE=local
ASR_URL=
# CPU/dev: models/asr/faster-whisper-small · GPU/demo: models/asr/whisper-turbo-ct2
ASR_MODEL=models/asr/faster-whisper-small
# cpu | cuda
ASR_DEVICE=cpu
# cpu: int8 · cuda: int8_float16 or float16
ASR_COMPUTE_TYPE=int8
# decoding beam (1 = fastest; 5 = more accurate, slower)
ASR_BEAM_SIZE=1

# --- TTS read-back (GPU only; off = on-screen card + replay of own recording) ---
TTS_ENABLED=false

# --- Optional cloud engine: ChatGPT API ("तेज़" mode in Settings; off unless set). Falls back to local. ---
# The key's OpenAI project must have access to each model below (Project → Limits → Model access).
CHAT_API_KEY=
# CHAT_BASE_URL=https://api.openai.com/v1
# CHAT_LLM_MODEL=gpt-5.4-mini
# CHAT_ASR_MODEL=whisper-1
# CHAT_TTS_MODEL=gpt-4o-mini-tts
# CHAT_TTS_VOICE=coral

# --- Telegram thekedar agent (from @BotFather; leave empty to disable) ---
# TG_AGENT: template = fixed templates only · chatgpt = ChatGPT writes replies for the worker (needs CHAT_API_KEY;
# every reply checked by code, falls back to templates)
TG_AGENT=template
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# If the network blocks api.telegram.org (some campus/venue Wi-Fi): use a phone hotspot, or a proxy, e.g.
# TELEGRAM_PROXY=http://127.0.0.1:8888  (socks5:// needs: pip install "python-telegram-bot[socks]")
TELEGRAM_PROXY=

# --- App ---
DEMO_MODE=true
DATA_DIR=data
HOST=0.0.0.0
PORT=8443
CERT_FILE=certs/cert.pem
KEY_FILE=certs/key.pem
